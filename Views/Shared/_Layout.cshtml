<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staybnb</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar sb-navbar bg-white border-bottom sticky-top">
        <div class="container-xl d-flex align-items-center justify-content-between">
            <a class="sb-brand" asp-controller="Home" asp-action="Index"><i class="bi bi-house-heart-fill"></i> staybnb</a>

            <a class="sb-search d-none d-md-flex" asp-controller="Properties" asp-action="Index">
                <span>Anywhere</span><span>Any week</span><span class="text-muted">Add guests</span>
                <span class="sb-search-btn"><i class="bi bi-search"></i></span>
            </a>

            <div class="d-flex align-items-center gap-3">
                @if (User.Identity.IsAuthenticated)
                {
                    @if (User.IsInRole(AppRoles.Guest))
                    {
                        <a class="sb-link d-none d-lg-inline" asp-controller="HostApplication" asp-action="Status">Host Application Status</a>
                        <a class="sb-link d-none d-lg-inline" asp-controller="HostApplication" asp-action="Create">Become a Host</a>
                    }
                    @await Component.InvokeAsync("NotificationBell")
                    <div class="dropdown">
                        <button class="sb-user-chip" data-bs-toggle="dropdown" type="button">
                            <i class="bi bi-list"></i><span class="sb-avatar">@User.Identity.Name.Substring(0, 1).ToUpper()</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li class="dropdown-header">@User.Identity.Name</li>
                            @if (User.IsInRole(AppRoles.Guest))
                            {
                                <li><a class="dropdown-item" asp-controller="Bookings" asp-action="MyTrips">My Trips</a></li>
                                <li><a class="dropdown-item" asp-controller="Properties" asp-action="Wishlist">Wishlist</a></li>
                            }
                            <li><a class="dropdown-item" asp-controller="Messages" asp-action="Inbox">Messages</a></li>
                            <li><a class="dropdown-item" asp-controller="Notifications" asp-action="Index">Notifications</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-sb">Log out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="sb-link" asp-controller="Account" asp-action="Login">Log in</a>
                    <a class="btn btn-sb btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Register">Sign up</a>
                }
            </div>
        </div>
    </nav>

    <main class="container-xl py-4">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="border-top py-3 text-center text-muted small">&copy; @DateTime.Now.Year Staybnb &middot;</footer>

    <script>
    // listing photos come from a CDN, fall back to the bundled artwork if one fails
    document.addEventListener('error', function (e) {
        var img = e.target;
        if (img.tagName === 'IMG' && !img.dataset.fallback) {
            img.dataset.fallback = '1';
            img.src = '/images/seed/ext_apartment_0.svg';
        }
    }, true);
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
