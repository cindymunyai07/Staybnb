@model PropertyFormViewModel
@{ var requireImages = ViewData["RequireImages"] as bool? ?? false; }
<div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" maxlength="100" required />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="PropertyType" class="form-label"></label>
        <select asp-for="PropertyType" class="form-select" asp-items="@(PropertyTypes.All.Select(t => new SelectListItem(t, t)))" required>
            <option value="">Select...</option>
        </select>
        <span asp-validation-for="PropertyType" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" required />
        <span asp-validation-for="Address" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="City" class="form-label"></label>
        <input asp-for="City" class="form-control" required />
        <span asp-validation-for="City" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="PricePerNight" class="form-label"></label>
        <input asp-for="PricePerNight" type="number" step="0.01" min="1" class="form-control" required />
        <span asp-validation-for="PricePerNight" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="CleaningFee" class="form-label"></label>
        <input asp-for="CleaningFee" type="number" step="0.01" min="0" class="form-control" required />
        <span asp-validation-for="CleaningFee" class="text-danger small"></span>
    </div>
    <div class="col-6 col-md-2"><label asp-for="MaxGuests" class="form-label"></label><input asp-for="MaxGuests" type="number" min="1" class="form-control" /></div>
    <div class="col-6 col-md-2"><label asp-for="Bedrooms" class="form-label"></label><input asp-for="Bedrooms" type="number" min="0" class="form-control" /></div>
    <div class="col-6 col-md-1"><label asp-for="Beds" class="form-label"></label><input asp-for="Beds" type="number" min="1" class="form-control" /></div>
    <div class="col-6 col-md-1"><label asp-for="Bathrooms" class="form-label">Baths</label><input asp-for="Bathrooms" type="number" min="1" class="form-control" /></div>

    <div class="col-12">
        <label class="form-label">Amenities</label>
        <div>
            @foreach (var a in Model.AllAmenities)
            {
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="SelectedAmenityIds" value="@a.Id" id="am@(a.Id)" checked="@Model.SelectedAmenityIds.Contains(a.Id)" />
                    <label class="form-check-label" for="am@(a.Id)"><i class="bi @a.IconClass"></i> @a.Name</label>
                </div>
            }
        </div>
    </div>

    <div class="col-12">
        @if (Model.ExistingImages.Any())
        {
            <label class="form-label">Current images</label>
            <div class="d-flex flex-wrap gap-2 mb-2">
                @foreach (var img in Model.ExistingImages) { <img class="sb-thumb" src="@img.ImageUrl" alt="" /> }
            </div>
        }
        <label asp-for="Images" class="form-label">@(requireImages ? "Property images (at least one is required)" : "Add more images (optional)")</label>
        <input asp-for="Images" type="file" multiple accept=".jpg,.jpeg,.png,.webp" class="form-control" required="@requireImages" />
        <div class="form-text">JPG, PNG or WEBP, max 5 MB each.</div>
        <span asp-validation-for="Images" class="text-danger small"></span>
    </div>
</div>
