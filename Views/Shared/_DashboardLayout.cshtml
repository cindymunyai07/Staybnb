@{
    var isHost = User.IsInRole(AppRoles.Host);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, params string[] actions) =>
        controller == c && (actions.Length == 0 || actions.Contains(action)) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staybnb @(isHost ? "Host" : "Admin")</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div class="sb-shell">
    <aside class="sb-sidebar">
        <a class="sb-brand" asp-controller="Home" asp-action="Index"><i class="bi bi-house-heart-fill"></i> staybnb <small class="fw-normal text-muted fs-6">@(isHost ? "host" : "admin")</small></a>
        <nav class="sb-menu">
            @if (isHost)
            {
                <a class="@Active("Host", "Dashboard")" asp-controller="Host" asp-action="Dashboard"><i class="bi bi-pie-chart-fill"></i> Dashboard</a>
                <a class="@Active("Host", "Properties", "EditProperty", "ConfigureCheckIn")" asp-controller="Host" asp-action="Properties"><i class="bi bi-house-fill"></i> My Properties</a>
                <a class="@Active("Host", "Bookings")" asp-controller="Host" asp-action="Bookings"><i class="bi bi-calendar-check-fill"></i> Booking Requests</a>
                <a class="@Active("Host", "Documents")" asp-controller="Host" asp-action="Documents"><i class="bi bi-person-vcard-fill"></i> Guest Documents</a>
                <a class="@Active("Host", "Earnings")" asp-controller="Host" asp-action="Earnings"><i class="bi bi-cash-stack"></i> Earnings</a>
                <a class="@Active("Host", "Reviews")" asp-controller="Host" asp-action="Reviews"><i class="bi bi-star-fill"></i> Reviews</a>
            }
            else
            {
                <a class="@Active("Admin", "Dashboard")" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-pie-chart-fill"></i> Dashboard</a>
                @if (User.IsInRole(AppRoles.SuperAdmin))
                {
                    <a class="@Active("Admin", "Users")" asp-controller="Admin" asp-action="Users"><i class="bi bi-people-fill"></i> Users</a>
                }
                <a class="@Active("Admin", "Applications", "ReviewApplication")" asp-controller="Admin" asp-action="Applications"><i class="bi bi-file-earmark-text-fill"></i> Host Requests</a>
                <a class="@Active("Admin", "Bookings")" asp-controller="Admin" asp-action="Bookings"><i class="bi bi-calendar-check-fill"></i> Bookings</a>
                <a class="@Active("Admin", "Properties")" asp-controller="Admin" asp-action="Properties"><i class="bi bi-house-fill"></i> Properties</a>
            }
            <a class="@Active("Messages")" asp-controller="Messages" asp-action="Inbox"><i class="bi bi-envelope-fill"></i> Messages</a>
            <a class="@Active("Notifications")" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell-fill"></i> Notifications</a>
            @if (!isHost)
            {
                <a class="@Active("Admin", "Logs")" asp-controller="Admin" asp-action="Logs"><i class="bi bi-clock-history"></i> Activity Logs</a>
            }
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="logout"><i class="bi bi-box-arrow-right"></i> Logout</button>
            </form>
        </nav>
    </aside>

    <div class="sb-main">
        <div class="sb-topbar">
            <h1>@ViewData["Title"]</h1>
            <div class="d-flex align-items-center gap-2">
                @await Component.InvokeAsync("NotificationBell")
                <span class="sb-user-chip"><span class="sb-avatar">@User.Identity.Name.Substring(0, 1).ToUpper()</span> @User.Identity.Name
                    <small class="text-muted">@(User.IsInRole(AppRoles.SuperAdmin) ? "SuperAdmin" : isHost ? "Host" : "Admin")</small></span>
            </div>
        </div>
        <div class="sb-content">
            <partial name="_Alerts" />
            @RenderBody()
        </div>
    </div>
</div>
<script>
    // listing photos come from a CDN, fall back to the bundled artwork if one fails
    document.addEventListener('error', function (e) {
        var img = e.target;
        if (img.tagName === 'IMG' && !img.dataset.fallback) {
            img.dataset.fallback = '1';
            img.src = '/images/seed/ext_apartment_0.svg';
        }
    }, true);
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
