@model GuestCheckIn
@{
    ViewData["Title"] = "Online check-in";
    var b = Model.Booking;
    var p = b.Property;
    var cfg = CheckInConfig.Parse(Model.CheckInProcess.StepsJson);
    var st = Model.Status;
    var verified = b.Status == BookingStatus.CheckedIn || st == CheckInStatus.Verified;
    var rulesDone = st != CheckInStatus.NotStarted;
    var docSent = st == CheckInStatus.DocumentSubmitted || verified;
    var now = !rulesDone ? 2 : (!docSent ? 3 : (!verified ? 4 : 5));
    string StepClass(int i) => i < now ? "done" : (i == now ? "now" : "");
    var labels = new[] { "Trip details", "House rules", "Upload ID", "Host verifies", "Checked in" };
}

<h1 class="h3 mb-1">Online check-in</h1>
<p class="text-muted">@cfg.Instructions</p>

<div class="sb-steps">
    @for (var i = 1; i <= 5; i++)
    {
        <div class="sb-step @StepClass(i)">@i. @labels[i - 1]</div>
    }
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="sb-panel mb-3">
            <h2 class="h6 text-uppercase text-muted">Step 1 &middot; Trip details</h2>
            <div class="fw-semibold">@p.Title</div>
            <div class="small">@p.Address, @p.City</div>
            <div class="small">@b.CheckInDate.ToString("ddd dd MMM yyyy") &rarr; @b.CheckOutDate.ToString("ddd dd MMM yyyy") &middot; @b.NumberOfGuests guest@(b.NumberOfGuests > 1 ? "s" : "")</div>
        </div>

        <div class="sb-panel mb-3">
            <h2 class="h6 text-uppercase text-muted">Step 2 &middot; House rules</h2>
            @if (cfg.Rules.Any())
            {
                <ul>@foreach (var r in cfg.Rules) { <li>@r</li> }</ul>
            }
            else
            {
                <p class="text-muted">The host has not set any special rules.</p>
            }
            @if (!rulesDone)
            {
                <form asp-action="AcceptRules" asp-route-id="@b.Id" method="post">
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="accepted" value="true" id="accepted" />
                        <label class="form-check-label" for="accepted">I have read and accept the house rules</label>
                    </div>
                    <button class="btn btn-sb" type="submit">Accept and continue</button>
                </form>
            }
            else
            {
                <span class="badge bg-success"><i class="bi bi-check"></i> Accepted @Model.RulesAcceptedAt?.ToString("dd MMM HH:mm")</span>
            }
        </div>

        @if (rulesDone)
        {
            <div class="sb-panel mb-3">
                <h2 class="h6 text-uppercase text-muted">Step 3 &middot; Upload your ID or passport</h2>
                @if (st == CheckInStatus.RulesAccepted)
                {
                    <form asp-action="UploadDocument" asp-route-id="@b.Id" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label">Document type</label>
                            <select name="documentType" class="form-select">
                                @foreach (var d in cfg.RequiredDocuments) { <option value="@d">@d</option> }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">File (JPG, PNG or PDF, max 5 MB)</label>
                            <input type="file" name="document" class="form-control" accept=".jpg,.jpeg,.png,.pdf" required />
                        </div>
                        <button class="btn btn-sb" type="submit"><i class="bi bi-upload"></i> Upload for verification</button>
                    </form>
                }
                else if (st == CheckInStatus.DocumentSubmitted)
                {
                    <div class="alert alert-warning mb-0"><i class="bi bi-hourglass-split"></i> Step 4 &middot; Waiting for the host to verify your document.</div>
                }
                else
                {
                    <div class="alert alert-success mb-0"><i class="bi bi-check-circle-fill"></i> Your document was verified. You are checked in &ndash; enjoy your stay!</div>
                }
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="sb-panel">
            <h2 class="h6 text-uppercase text-muted">Your documents</h2>
            @if (!Model.Documents.Any())
            {
                <p class="text-muted small mb-0">Nothing uploaded yet.</p>
            }
            @foreach (var d in Model.Documents.OrderByDescending(d => d.UploadedAt))
            {
                <div class="border-bottom py-2">
                    <div class="d-flex justify-content-between">
                        <span>@d.DocumentType</span>
                        <span class="badge @UiHelpers.BadgeClass(d.Status.ToString())">@d.Status</span>
                    </div>
                    <div class="small text-muted">@d.UploadedAt.ToString("dd MMM HH:mm") &middot; <a asp-controller="Files" asp-action="Document" asp-route-id="@d.Id" target="_blank">view</a></div>
                    @if (!string.IsNullOrEmpty(d.ReviewNote)) { <div class="small text-danger">Host note: @d.ReviewNote</div> }
                </div>
            }
        </div>
        <a class="btn btn-link mt-2" asp-action="MyTrips">&larr; Back to my trips</a>
    </div>
</div>
