@model LogsViewModel
@{ ViewData["Title"] = "Activity Logs"; }
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input name="search" value="@Model.Search" class="form-control" placeholder="Search action, details or user email" /></div>
    <div class="col-md-3">
        <select name="type" class="form-select">
            <option value="">All types</option>
            @foreach (var t in Enum.GetValues<ActivityType>()) { <option value="@t" selected="@(Model.Type == t)">@t</option> }
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-sb" type="submit">Filter</button></div>
</form>
<div class="sb-panel">
    <table class="table table-sm mb-0">
        <thead><tr><th>When</th><th>User</th><th>Type</th><th>Action</th><th>Details</th></tr></thead>
        <tbody>
        @foreach (var l in Model.Logs)
        {
            <tr><td class="text-nowrap">@l.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td><td>@(l.User?.Email ?? "System")</td><td><span class="badge bg-light text-dark border">@l.ActivityType</span></td><td>@l.Action</td><td class="small text-muted">@l.Details</td></tr>
        }
        @if (!Model.Logs.Any()) { <tr><td colspan="5" class="text-muted">No log entries.</td></tr> }
        </tbody>
    </table>
</div>
<nav class="mt-3 d-flex gap-2 align-items-center">
    @if (Model.Page > 1) { <a class="btn btn-outline-secondary btn-sm" asp-action="Logs" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-type="@Model.Type">&laquo; Prev</a> }
    <span class="small text-muted">Page @Model.Page of @Model.TotalPages</span>
    @if (Model.Page < Model.TotalPages) { <a class="btn btn-outline-secondary btn-sm" asp-action="Logs" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-type="@Model.Type">Next &raquo;</a> }
</nav>
