@model List<HostProperty>
@{ ViewData["Title"] = "My Properties"; }
<div class="d-flex justify-content-between mb-3">
    <span class="text-muted">@Model.Count listing@(Model.Count == 1 ? "" : "s")</span>
    <a class="btn btn-sb btn-sm" asp-controller="HostApplication" asp-action="Create"><i class="bi bi-plus-lg"></i> Add new property</a>
</div>
@foreach (var p in Model)
{
    <div class="sb-panel mb-3">
        <div class="d-flex flex-wrap gap-3 align-items-center">
            <img class="sb-thumb" style="width:150px;height:105px" src="@(p.Images.FirstOrDefault()?.ImageUrl ?? UiHelpers.Placeholder)" alt="" />
            <div class="flex-grow-1">
                <div class="fw-semibold">@p.Title</div>
                <div class="small text-muted"><i class="bi bi-geo-alt"></i> @p.City &middot; @p.PropertyType &middot; @p.MaxGuests guests &middot; @p.Beds beds</div>
                <div class="small text-muted">@p.Bookings.Count booking@(p.Bookings.Count == 1 ? "" : "s") &middot; @(p.Reviews.Count == 0 ? "No reviews" : p.Reviews.Count + " reviews")</div>
            </div>
            <div class="text-end">
                <div class="fw-bold">@UiHelpers.Money(p.PricePerNight) <small class="text-muted fw-normal">/ night</small></div>
                @if (!p.IsApproved) { <span class="badge bg-warning text-dark">Awaiting approval</span> }
                else if (p.IsActive) { <span class="badge bg-success">Active</span> }
                else { <span class="badge bg-secondary">Inactive</span> }
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-3 justify-content-end">
            <a class="btn btn-outline-secondary btn-sm" asp-controller="Properties" asp-action="Details" asp-route-id="@p.Id"><i class="bi bi-eye"></i> View details</a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="EditProperty" asp-route-id="@p.Id"><i class="bi bi-pencil"></i> Edit</a>
            @if (p.IsApproved)
            {
                <a class="btn btn-outline-secondary btn-sm" asp-action="ConfigureCheckIn" asp-route-propertyId="@p.Id"><i class="bi bi-clipboard-check"></i> Check-in process</a>
                <form asp-action="ToggleActive" asp-route-id="@p.Id" method="post">
                    <button type="submit" class="btn btn-sm @(p.IsActive ? "btn-danger" : "btn-success")">@(p.IsActive ? "Deactivate" : "Activate")</button>
                </form>
            }
        </div>
    </div>
}
@if (!Model.Any()) { <p class="text-muted">No properties yet.</p> }
